@@ -0,0 +1,7 @@
+// The local preview server supplies the shared bridge; the Lab owns this mount.
+import { mountReadingBridge } from '/__bridge/ui.mjs';
+
+const element = document.querySelector('#lab-reading-bridge');
+if (element) {
+  mountReadingBridge({ element, apiBase: '/__bridge/api', appLabel: 'Agent Art Lab' });
+}
