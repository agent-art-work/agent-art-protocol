+.aap-gate .aap-gate-mark { position: relative; display: inline-block; flex: 0 0 var(--_gate-mark-size); width: var(--_gate-mark-size); height: var(--_gate-mark-size); color: currentColor; }
+.aap-gate .aap-gate-mark::before, .aap-gate .aap-gate-mark::after { content: ''; position: absolute; }
