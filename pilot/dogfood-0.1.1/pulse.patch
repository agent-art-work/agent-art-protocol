diff --git a/evm/playground/generate-reading.js b/evm/playground/generate-reading.js
new file mode 100644
index 0000000000000000000000000000000000000000..697508e9bdd9be3c5d8fd61fadce0108b6fb41d4
--- /dev/null
+++ b/evm/playground/generate-reading.js
@@ -0,0 +1,19 @@
+import { build } from "esbuild";
+import { readFileSync } from "node:fs";
+import { createRequire } from "node:module";
+import { fileURLToPath } from "node:url";
+
+const require = createRequire(import.meta.url);
+
+/** Bundle the installed private SDK; never publish its Node/build helpers. */
+export async function generateReading() {
+  const bundle = await build({
+    entryPoints: [fileURLToPath(new URL("reading-entry.js", import.meta.url))],
+    bundle: true, write: false, format: "iife", platform: "browser", target: "es2022", minify: true,
+    loader: { ".txt": "text" },
+  });
+  return new Map([
+    ["reading.js", Buffer.from(bundle.outputFiles[0].contents)],
+    ["reading.css", readFileSync(require.resolve("@agent-art/protocol/reading.css"))],
+  ]);
+}
