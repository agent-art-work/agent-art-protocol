+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { createReading } from "@agent-art/protocol/reading";
+import { pulseReadingWork } from "./reading-profile.js";
+
+test("Pulse retains the complete owner invitation and public reading boundaries", async () => {
+  const prompt = readFileSync(new URL("docs/agent-prompt.txt", import.meta.url), "utf8");
+  const reading = createReading({ work: pulseReadingWork(prompt) });
+  assert.equal(reading.context, prompt);
+  assert.equal(reading.work.context[1].url, "https://pulse.inshell.art/docs/agent-index.json");
+  assert.match(reading.context, /Live verification requires a distinct user request/);
+  const native = reading.prepare({ client: "claude-app", conversation: "fresh" });
+  assert.equal(new URL(native.url).searchParams.get("q"), prompt);
+  const chatgpt = reading.prepare({ client: "codex-app", conversation: "fresh" });
+  const chatgptURL = new URL(chatgpt.url);
+  assert.equal(chatgptURL.protocol, "codex:");
+  assert.equal(chatgptURL.hostname, "new");
+  assert.equal(chatgptURL.searchParams.get("prompt"), prompt);
+  assert.deepEqual([...chatgptURL.searchParams.keys()], ["prompt"]);
+  assert.deepEqual([...new URL(native.url).searchParams.keys()], ["q"]);
+  const existing = reading.prepare({ client: "codex-app", conversation: "existing" });
+  assert.equal(existing.kind, "manual");
+  assert.equal(existing.context, prompt);
+  const receipt = await reading.receipt({ event: "context-copied", client: "manual", observer: "fixture-browser" });
+  assert.deepEqual(receipt.acts, []);
+  assert.deepEqual(receipt.participants, []);
+  assert.deepEqual(receipt.relations, []);
+  assert.match(receipt.observations[0].limits.join(" "), /No Send, model exposure, reading, answer/);
+});
