diff --git a/evm/playground/reading-entry.js b/evm/playground/reading-entry.js
new file mode 100644
index 0000000000000000000000000000000000000000..e7fb0c3dbc9d01a133b861842e49747a8f244597
--- /dev/null
+++ b/evm/playground/reading-entry.js
@@ -0,0 +1,28 @@
+import { mountReading } from "@agent-art/protocol/reading-ui";
+import prompt from "./docs/agent-prompt.txt";
+import { pulseReadingWork, PULSE_READING_ORIGIN } from "./reading-profile.js";
+
+const host = document.getElementById("reading-sdk");
+const manual = document.getElementById("manual-agent-guide");
+const original = document.getElementById("agent-guide");
+if (host && manual && original) {
+  try {
+    // Native desktop links are offered without claiming installed-app discovery.
+    mountReading(host, { work: pulseReadingWork(prompt), evidence: true });
+    host.classList.add("reading-column", "pulse-reading");
+    original.before(host);
+    original.hidden = true;
+    if (window.location.origin !== PULSE_READING_ORIGIN) {
+      // Keep the owner's local-preview prompt distinct from public reading.
+      manual.classList.add("disclosure", "agent-guide", "reading-column", "reading-manual");
+      manual.querySelector("summary").textContent = "Copy the local preview prompt";
+      const note = document.createElement("p");
+      note.textContent = "Agent controls offer public Pulse documentation. This manual prompt uses this preview address instead.";
+      manual.querySelector("summary").after(note);
+      host.after(manual);
+    }
+  } catch {
+    // Preserve the original manual disclosure if the shared UI cannot mount.
+    host.textContent = "Agent controls are unavailable. Use the manual prompt below.";
+  }
+}
diff --git a/evm/playground/reading-profile.js b/evm/playground/reading-profile.js
new file mode 100644
index 0000000000000000000000000000000000000000..5ebf84aa5c40bffbcbea8313a607ea1bf694c810
--- /dev/null
+++ b/evm/playground/reading-profile.js
@@ -0,0 +1,25 @@
+import { defineWork } from "@agent-art/protocol";
+
+export const PULSE_READING_ORIGIN = "https://pulse.inshell.art";
+
+/** The site owns this invitation and its public, read-only source policy. */
+export function pulseReadingWork(prompt) {
+  return defineWork({
+    id: "pulse:public-reading", version: "2026-09-27-r7:reading-0.1.1",
+    title: "Read Pulse with your Agent",
+    purpose: "Explore Pulse's public documentation in the visitor's own Agent conversation.",
+    publisher: { id: "inshell", label: "Inshell" },
+    capabilities: ["handoff"],
+    context: [
+      { id: "reading-invitation", kind: "text", mode: "snapshot", text: prompt },
+      { id: "public-index", kind: "reference", mode: "live", url: `${PULSE_READING_ORIGIN}/docs/agent-index.json` },
+    ],
+    conditions: {
+      purpose: "Public documentation reading only; the interactive calculator is separate.",
+      methods: ["GET", "HEAD"],
+      authority: "The owner-authored invitation and fetched index define source selection and answer policy.",
+      notAuthorized: ["wallet actions", "transactions", "pricing execution", "RPC or live chain verification"],
+      limits: "The handoff offers the published index URL. This site does not observe sending, retrieval, reading or answers.",
+    },
+  });
+}
